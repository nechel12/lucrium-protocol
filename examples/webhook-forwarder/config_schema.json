{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Webhook-форвардер",
  "description": "Куда и какие события отправлять. Панель рендерит эту форму автоматически.",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {
      "type": "string",
      "title": "URL webhook",
      "description": "POST с JSON-телом на каждое выбранное событие.",
      "format": "uri",
      "maxLength": 2000
    },
    "secret": {
      "type": "string",
      "title": "Секрет",
      "description": "Если задан — отправляется в заголовке X-Lucrium-Secret.",
      "default": "",
      "maxLength": 500
    },
    "kinds": {
      "type": "array",
      "title": "Типы событий",
      "description": "Пусто — все события.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["initial", "message", "review", "order", "purchase", "deal", "list", "other"]
      },
      "default": []
    },
    "timeout_seconds": {
      "type": "number",
      "title": "Таймаут запроса, сек",
      "default": 10,
      "minimum": 0.5,
      "maximum": 120
    }
  }
}
